<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingGuestRules>
        <fullName>Website_Guest_Access</fullName>
        <accessLevel>Read</accessLevel>
        <label>Website Guest Access</label>
        <sharedTo>
            <guestUser>Website_API</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>Website_Identifier__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
