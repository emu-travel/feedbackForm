<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NPS_Category__c</fullName>
    <description
  >Promoter / Passive / Detractor derived from Recommendation_NPS__c. Note the survey uses a 1-10 scale, not the classic 0-10, and 9+ is the threshold that also triggers the public review invitation.</description>
    <externalId>false</externalId>
    <formula>IF(
  ISBLANK(Recommendation_NPS__c), &quot;&quot;,
  IF(Recommendation_NPS__c &gt;= 9, &quot;Promoter&quot;,
    IF(Recommendation_NPS__c &gt;= 7, &quot;Passive&quot;, &quot;Detractor&quot;)
  )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>NPS Category</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
