<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description
  >Internal access to post-trip guest feedback. Assign to travel designers, service staff and admins who read or correct feedback. Guest access is separate (Golf_Extra_Feedback_Guest), exposing only the Apex controller.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Golf Extra Feedback - Admin</label>

    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Booking__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Reservation__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Feedback_Response__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Feedback_Rating__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Consultation_Comment__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Consultation_Rating__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Contact__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.General_Feedback__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Improvement_Suggestions__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Language__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Next_Destination__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Overall_Experience_Comment__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Overall_Experience__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Public_Review_Prompted__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Recommendation_NPS__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.Submitted_On__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>false</editable>
        <field>Feedback_Response__c.NPS_Category__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Rating__c.Comment__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Rating__c.Item_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Rating__c.Reservation__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Rating__c.Sub_Category__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.General_Hotel_Comment__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Feedback_Response__c.General_Golf_Comment__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>false</editable>
        <field>Booking__c.Survey_Link__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!--
      System-maintained, so readable but not editable: staff need to see when a
      guest was last asked and whether they have already been reminded, without
      being able to hand-edit the dispatch's own bookkeeping.
    -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Booking__c.Survey_Sent_On__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Booking__c.Survey_Reminder_Sent__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Booking__c.Survey_Destination_Phrase__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Booking__c.Survey_Trip_Summary__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Booking__c.Survey_Logo_URL__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!--
      What the "Feedback-Umfrage senden" button on a Booking needs. The flow
      runs in the user's own context, so whoever presses it also needs edit on
      Booking__c - which travel designers already have from their profile.
    -->
    <classAccesses>
        <apexClass>GxFeedbackSender</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>GxFeedbackDispatch</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <flowAccesses>
        <enabled>true</enabled>
        <flow>Gx_Send_Feedback_Survey</flow>
    </flowAccesses>
</PermissionSet>
